<% layout('/layouts/boilerplate') %>

<div class="page-wrap">
  <div class="page-header">
    <div>
      <h1 class="page-header__title">Booking Details</h1>
      <p class="page-header__sub">All confirmed bookings for this listing</p>
    </div>
    <a href="/listings/dashboard" class="btn btn-outline-secondary">
      <i class="fa-solid fa-arrow-left"></i> Dashboard
    </a>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="empty-state">
      <i class="fa-regular fa-calendar-xmark"></i>
      <h2>No bookings yet</h2>
      <p>Once guests book, their details will appear here.</p>
    </div>
  <% } else { %>
    <div class="booking-list">
      <% bookings.forEach((booking, i) => { %>
        <div class="booking-item">
          <div class="booking-item__body">
            <div class="booking-item__top">
              <div class="booking-item__guest">
                <div class="booking-item__avatar">
                  <%= (booking.user?.username || 'U')[0].toUpperCase() %>
                </div>
                <div>
                  <p class="booking-item__title"><%= booking.user?.username || 'Unknown' %></p>
                  <p class="booking-item__location"><%= booking.user?.email || 'N/A' %></p>
                </div>
              </div>
              <span class="badge bg-success"><%= booking.status %></span>
            </div>
            <% if (booking.checkIn && booking.checkOut) { %>
              <div class="booking-item__dates">
                <span class="booking-item__date">
                  <i class="fa-regular fa-calendar"></i>
                  <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %>
                </span>
                <i class="fa-solid fa-arrow-right"></i>
                <span class="booking-item__date">
                  <i class="fa-regular fa-calendar"></i>
                  <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %>
                </span>
                <% if (booking.nights) { %>
                  <span class="booking-item__nights"><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></span>
                <% } %>
              </div>
            <% } %>
            <div class="booking-item__footer">
              <span class="booking-item__amount">₹<%= (booking.amount / 100).toLocaleString('en-IN') %></span>
              <span class="booking-item__when">Booked <%= booking.createdAt.toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></span>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
