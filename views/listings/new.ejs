<% layout("/layouts/boilerplate")%>
<% var listing = typeof listing !== 'undefined' ? listing : {}; %>

<div class="form-page">
  <div class="form-card">
    <h1 class="form-card__title">Add a new listing</h1>
    <p class="form-card__sub">Fill in the details and let guests discover your space</p>

    <% if (typeof error !== 'undefined') { %>
      <div class="alert alert-danger"><%= error %></div>
    <% } %>

    <form method="POST" action="/listings" class="needs-validation" novalidate enctype="multipart/form-data">

      <div class="mb-3">
        <label for="title" class="form-label">Title</label>
        <input class="form-control" type="text" name="listing[title]"
          placeholder="e.g. Cozy cabin by the lake"
          value="<%= listing.title || '' %>" required />
        <div class="invalid-feedback">Please enter a title.</div>
      </div>

      <div class="mb-3">
        <label for="description" class="form-label">Description</label>
        <textarea name="listing[description]" class="form-control" rows="4"
          placeholder="Describe your space…" required><%= listing.description || '' %></textarea>
        <div class="invalid-feedback">Please add a description.</div>
      </div>

      <div class="mb-3">
        <label class="form-label">Image URL <span class="text-muted fw-normal">(optional)</span></label>
        <input class="form-control" type="text" name="listing[image][url]"
          placeholder="https://…"
          value="<%= (listing.image && listing.image.url) || '' %>" />
      </div>

      <div class="mb-3">
        <label class="form-label">Upload image</label>
        <input class="form-control" type="file" name="listing[image]" accept="image/*" />
      </div>

      <div class="form-grid">
        <div class="mb-3">
          <label class="form-label">Price per night (₹)</label>
          <input class="form-control" type="number" name="listing[price]"
            placeholder="e.g. 2500" value="<%= listing.price || '' %>" min="0" required />
          <div class="invalid-feedback">Please enter a valid price.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Category</label>
          <select class="form-select" name="listing[category]" required>
            <option value="" disabled selected>Select category</option>
            <% ['Apartment','Villa','Cottage','Beach House','Cabin'].forEach(cat => { %>
              <option value="<%= cat %>" <%= (listing.category === cat) ? 'selected' : '' %>><%= cat %></option>
            <% }) %>
          </select>
          <div class="invalid-feedback">Please select a category.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">City / Location</label>
          <input class="form-control" type="text" name="listing[location]"
            placeholder="e.g. Manali, HP" value="<%= listing.location || '' %>" required />
          <div class="invalid-feedback">Please enter a location.</div>
        </div>
        <div class="mb-3">
          <label class="form-label">Country</label>
          <input class="form-control" type="text" name="listing[country]"
            placeholder="e.g. India" value="<%= listing.country || '' %>" required />
          <div class="invalid-feedback">Please enter a country.</div>
        </div>
      </div>

      <div class="form-card__actions">
        <a href="/listings" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-dark add-btn">Add listing</button>
      </div>
    </form>
  </div>
</div>
