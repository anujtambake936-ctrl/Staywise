<% layout("/layouts/boilerplate")%>

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
<script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>

<div class="show-wrap">

  <!-- Hero image -->
  <div class="show-hero">
    <img src="<%= listing.image.url %>" alt="<%= listing.title %>">
    <span class="show-hero__badge"><%= listing.category %></span>
  </div>

  <!-- Two-column layout -->
  <div class="show-layout">

    <!-- LEFT: main content -->
    <div class="show-main">

      <h1 class="show-title"><%= listing.title %></h1>
      <p class="show-meta">
        <i class="fa-solid fa-location-dot"></i>
        <%= listing.location %>, <%= listing.country %>
      </p>
      <p class="show-host">Hosted by <strong><%= listing.Owner.username %></strong></p>

      <hr>

      <p class="show-description"><%= listing.description %></p>

      <hr>

      <!-- Map -->
      <h2 class="show-section-title">Where you'll be</h2>
      <div id="map"
        data-map-token="<%= process.env.MAP_TOKEN %>"
        data-coordinates='<%- JSON.stringify(listing.geometry.coordinates) %>'
        data-location="<%= listing.location %>">
      </div>

      <hr>

      <!-- Reviews -->
      <h2 class="show-section-title">
        Reviews
        <% if (listing.reviews.length > 0) { %>
          <span class="show-review-badge"><%= listing.reviews.length %></span>
        <% } %>
      </h2>

      <% if (listing.reviews.length === 0) { %>
        <p class="text-muted">No reviews yet. Be the first!</p>
      <% } else { %>
        <div class="review-grid">
          <% for (let review of listing.reviews) { %>
            <div class="review-card">
              <div class="review-card__top">
                <div class="review-card__avatar">
                  <%= (review.author ? review.author.username : 'A')[0].toUpperCase() %>
                </div>
                <div>
                  <p class="review-card__name"><%= review.author ? review.author.username : 'Anonymous' %></p>
                  <div class="review-card__stars">
                    <% for (let i = 1; i <= 5; i++) { %>
                      <i class="fa-<%= i <= review.rating ? 'solid' : 'regular' %> fa-star"></i>
                    <% } %>
                  </div>
                </div>
              </div>
              <p class="review-card__comment"><%= review.comment %></p>
              <% if (currUser && review.author && currUser._id.equals(review.author._id)) { %>
                <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                  <button class="btn btn-sm btn-outline-danger">
                    <i class="fa-solid fa-trash-can"></i> Delete
                  </button>
                </form>
              <% } %>
            </div>
          <% } %>
        </div>
      <% } %>

      <!-- Write review -->
      <% if (currUser && !currUser._id.equals(listing.Owner._id)) { %>
        <div class="review-form-box">
          <h3 class="show-section-title">Write a review</h3>
          <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
            <div class="mb-3">
              <label class="form-label">Rating</label>
              <fieldset class="starability-slot">
                <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                <input type="radio" id="first-rate1" name="review[rating]" value="1" /><label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" /><label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" /><label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" /><label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" /><label for="first-rate5" title="Amazing">5 stars</label>
              </fieldset>
            </div>
            <div class="mb-3">
              <label for="comment" class="form-label">Comment</label>
              <textarea name="review[comment]" id="comment" rows="4" class="form-control" required placeholder="Share your experience…"></textarea>
              <div class="invalid-feedback">Please add a comment.</div>
            </div>
            <button class="btn btn-outline-dark">Submit review</button>
          </form>
        </div>
      <% } %>

    </div>

    <!-- RIGHT: booking sidebar -->
    <aside class="show-sidebar">
      <div class="booking-card">

        <!-- Price -->
        <div class="booking-card__price">
          <span class="booking-card__amount">&#8377;<%= listing.price.toLocaleString("en-IN") %></span>
          <span class="booking-card__per"> / night</span>
        </div>
        <% const gst = Math.round(listing.price * 0.18); %>
        <p class="booking-card__gst">+ &#8377;<%= gst.toLocaleString("en-IN") %> GST (18%)</p>

        <hr>

        <% if (currUser) { %>
          <% if (!currUser._id.equals(listing.Owner._id)) { %>

            <div class="mb-3">
              <label class="form-label fw-semibold">Select dates</label>
              <input type="text" id="date-range-picker" class="form-control" placeholder="Check-in → Check-out" readonly />
              <input type="hidden" id="checkIn" />
              <input type="hidden" id="checkOut" />
            </div>

            <div id="price-summary" class="booking-card__summary" style="display:none;">
              <div class="booking-card__summary-row">
                <span id="nights-label"></span>
                <span>&#8377;<span id="total-price"></span></span>
              </div>
              <div class="booking-card__summary-row text-muted">
                <span>GST (18%)</span>
                <span>&#8377;<span id="gst-price"></span></span>
              </div>
              <hr>
              <div class="booking-card__summary-row booking-card__summary-row--total">
                <span>Total</span>
                <span>&#8377;<span id="grand-total"></span></span>
              </div>
            </div>

            <div id="booking-error" class="alert alert-danger d-none"></div>

            <button id="checkout-button" class="btn btn-primary w-100" disabled>
              Select dates to book
            </button>

          <% } else { %>
            <p class="text-muted mb-2 fw-semibold">You own this listing</p>
            <a href="/listings/<%= listing._id %>/edit" class="btn btn-outline-dark w-100 mb-2">
              <i class="fa-solid fa-pen"></i> Edit listing
            </a>
            <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
              <button class="btn btn-outline-danger w-100">
                <i class="fa-solid fa-trash-can"></i> Delete listing
              </button>
            </form>
          <% } %>
        <% } else { %>
          <a href="/login" class="btn btn-primary w-100">Log in to book</a>
        <% } %>

      </div>
    </aside>

  </div>
</div>

<script src="https://js.stripe.com/v3/"></script>
<script>
(function () {
  const pricePerNight  = <%= listing.price %>;
  const listingId      = '<%= listing._id %>';
  const publishableKey = '<%= process.env.STRIPE_PUBLISHABLE_KEY %>';
  const stripe         = publishableKey ? Stripe(publishableKey) : null;

  const checkoutBtn  = document.getElementById('checkout-button');
  const priceSummary = document.getElementById('price-summary');
  const bookingError = document.getElementById('booking-error');
  const checkInEl    = document.getElementById('checkIn');
  const checkOutEl   = document.getElementById('checkOut');

  if (!checkoutBtn) return;

  fetch(`/payments/booked-dates/${listingId}`)
    .then(r => r.json())
    .then(bookings => {
      const disabled = bookings
        .filter(b => b.checkIn && b.checkOut)
        .map(b => ({
          from: b.checkIn.slice(0, 10),
          to: new Date(new Date(b.checkOut) - 86400000).toISOString().slice(0, 10)
        }));
      initPicker(disabled);
    })
    .catch(() => initPicker([]));

  function initPicker(disabled) {
    flatpickr('#date-range-picker', {
      mode: 'range', minDate: 'today', dateFormat: 'Y-m-d', disable: disabled,
      onClose(dates) {
        if (dates.length === 2) {
          checkInEl.value  = dates[0].toISOString().slice(0, 10);
          checkOutEl.value = dates[1].toISOString().slice(0, 10);
          updateSummary(dates[0], dates[1]);
          setError('');
          checkoutBtn.disabled    = false;
          checkoutBtn.textContent = 'Book now';
        } else {
          checkoutBtn.disabled       = true;
          checkoutBtn.textContent    = 'Select dates to book';
          priceSummary.style.display = 'none';
        }
      }
    });
  }

  function updateSummary(ci, co) {
    const nights   = Math.round((co - ci) / 86400000);
    const subtotal = pricePerNight * nights;
    const gst      = Math.round(subtotal * 0.18);
    const grand    = subtotal + gst;
    document.getElementById('nights-label').textContent = `${nights} night${nights > 1 ? 's' : ''} × ₹${pricePerNight.toLocaleString('en-IN')}`;
    document.getElementById('total-price').textContent  = subtotal.toLocaleString('en-IN');
    document.getElementById('gst-price').textContent    = gst.toLocaleString('en-IN');
    document.getElementById('grand-total').textContent  = grand.toLocaleString('en-IN');
    priceSummary.style.display = 'block';
  }

  function setError(msg) {
    bookingError.textContent = msg;
    bookingError.classList.toggle('d-none', !msg);
  }

  checkoutBtn.addEventListener('click', async () => {
    const checkIn = checkInEl.value, checkOut = checkOutEl.value;
    if (!checkIn || !checkOut) return setError('Please select your dates first.');
    if (!stripe) return setError('Payment system unavailable. Try again later.');
    checkoutBtn.disabled = true;
    checkoutBtn.textContent = 'Redirecting…';
    setError('');
    try {
      const res  = await fetch(`/payments/create-session/${listingId}`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        credentials: 'same-origin', body: JSON.stringify({ checkIn, checkOut }),
      });
      const data = await res.json();
      if (!res.ok) { setError(data.error || 'Unable to create checkout.'); checkoutBtn.disabled = false; checkoutBtn.textContent = 'Book now'; return; }
      const result = await stripe.redirectToCheckout({ sessionId: data.id });
      if (result.error) { setError(result.error.message); checkoutBtn.disabled = false; checkoutBtn.textContent = 'Book now'; }
    } catch { setError('Payment failed. Please try again.'); checkoutBtn.disabled = false; checkoutBtn.textContent = 'Book now'; }
  });
})();
</script>
<script src="/js/map.js"></script>
