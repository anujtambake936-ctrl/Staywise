<% layout('/layouts/boilerplate') %>

<div class="page-wrap">
  <div class="page-header">
    <div>
      <h1 class="page-header__title">My Bookings</h1>
      <p class="page-header__sub">Your confirmed stays</p>
    </div>
  </div>

  <% if (bookings.length === 0) { %>
    <div class="empty-state">
      <i class="fa-regular fa-calendar-xmark"></i>
      <h2>No bookings yet</h2>
      <p>Explore listings and book your next stay.</p>
      <a href="/listings" class="btn btn-dark">Explore listings</a>
    </div>
  <% } else { %>
    <div class="booking-list">
      <% bookings.forEach(booking => { %>
        <div class="booking-item">
          <% if (booking.listing?.image?.url) { %>
            <div class="booking-item__img">
              <a href="/listings/<%= booking.listing._id %>">
                <img src="<%= booking.listing.image.url %>" alt="<%= booking.listing.title %>">
              </a>
            </div>
          <% } %>
          <div class="booking-item__body">
            <div class="booking-item__top">
              <h3 class="booking-item__title"><%= booking.listing?.title || 'Listing removed' %></h3>
              <span class="badge bg-success"><%= booking.status %></span>
            </div>
            <p class="booking-item__location">
              <i class="fa-solid fa-location-dot"></i>
              <%= booking.listing?.location || 'N/A' %>, <%= booking.listing?.country || '' %>
            </p>
            <% if (booking.checkIn && booking.checkOut) { %>
              <div class="booking-item__dates">
                <span class="booking-item__date">
                  <i class="fa-regular fa-calendar"></i>
                  <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %>
                </span>
                <i class="fa-solid fa-arrow-right"></i>
                <span class="booking-item__date">
                  <i class="fa-regular fa-calendar"></i>
                  <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { dateStyle: 'medium' }) %>
                </span>
                <% if (booking.nights) { %>
                  <span class="booking-item__nights"><%= booking.nights %> night<%= booking.nights > 1 ? 's' : '' %></span>
                <% } %>
              </div>
            <% } %>
            <div class="booking-item__footer">
              <span class="booking-item__amount">₹<%= (booking.amount / 100).toLocaleString('en-IN') %></span>
              <span class="booking-item__when">Booked <%= booking.createdAt.toLocaleDateString('en-IN', { dateStyle: 'medium' }) %></span>
              <% if (booking.listing) { %>
                <a href="/listings/<%= booking.listing._id %>" class="btn btn-sm btn-outline-dark">View listing</a>
              <% } %>
            </div>
          </div>
        </div>
      <% }) %>
    </div>
  <% } %>
</div>
